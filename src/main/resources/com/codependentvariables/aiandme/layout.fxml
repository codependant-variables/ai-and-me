<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.shape.SVGPath?>

<BorderPane styleClass="navBar" stylesheets="@stylesheet.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.codependentvariables.aiandme.controller.LayoutController">
    <top>
        <HBox alignment="CENTER" spacing="10.0">
            <ImageView fitHeight="47.0" fitWidth="145.0" layoutY="10.0" pickOnBounds="true" smooth="false">
                <image>
                    <Image url="@dark-logo.png" />
                </image>
            <HBox.margin>
               <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
            </HBox.margin>
            </ImageView>
            <Button onAction="#navigateHome" styleClass="navButton">Home</Button>
            <Button onAction="#navigateQuizLibrary" styleClass="navButton">Quiz Library</Button>
            <Button onAction="#navigateCheckin" styleClass="navButton">Daily Check-in</Button>
            <Button onAction="#navigateLogin" styleClass="navButton">Login</Button>
            <Button onAction="#navigateSignup" styleClass="navButton">Signup</Button>
            <Button minHeight="-Infinity" minWidth="-Infinity" mnemonicParsing="false" onAction="#switchTheme" prefHeight="36.0" prefWidth="26.0" styleClass="navButton">
                <graphic>
                    <SVGPath fx:id="themeToggleIcon" content="M29.2,26.72A12.07,12.07,0,0,1,22.9,4.44,13.68,13.68,0,0,0,19.49,4a14,14,0,0,0,0,28,13.82,13.82,0,0,0,10.9-5.34A11.71,11.71,0,0,1,29.2,26.72Z" fill="MEDIUMSLATEBLUE" nodeOrientation="LEFT_TO_RIGHT" scaleX="0.6" scaleY="0.6" />
                </graphic>
            </Button>
            <Button onAction="#navigateSettings" styleClass="navButton">Account Settings</Button>
        </HBox>
    </top>
    <center>
        <BorderPane fx:id="contentRef" />
    </center>
</BorderPane>
