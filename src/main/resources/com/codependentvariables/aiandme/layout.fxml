<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.geometry.Insets?>

<BorderPane stylesheets="@stylesheet.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.codependentvariables.aiandme.controller.LayoutController">
    <top>
        <HBox alignment="CENTER" prefHeight="100.0" styleClass="navbar, shadow">
            <padding>
                <Insets left="30" right="30" />
            </padding>

            <ImageView fx:id="logoRef" fitHeight="72.0" preserveRatio="true" layoutY="10.0">
                <Image url="@Images/dark-logo.png" />
            </ImageView>
            <Region HBox.hgrow="ALWAYS" />
            <Button onAction="#navigateHome" styleClass="nav-button" style="-fx-border-width: 0;" text="Home" wrapText="true" />
            <Button onAction="#navigateQuizLibrary" styleClass="nav-button" text="Quiz Library" wrapText="true" />
            <Button onAction="#navigatePuzzleLibrary" styleClass="nav-button" text="Puzzle Library" wrapText="true" />
            <Button onAction="#navigateCheckin" styleClass="nav-button" text="Daily Check-In" wrapText="true" />
            <Button fx:id="loginButton" onAction="#navigateLogin" styleClass="nav-button" text="Login" wrapText="true" />
            <Button fx:id="signupButton" onAction="#navigateSignup" styleClass="nav-button" text="Signup" wrapText="true" />
            <Button fx:id="profileButton" onAction="#navigateProfile" styleClass="nav-button" text="Profile" wrapText="true" />
            <Button onAction="#navigateSettings" styleClass="nav-button" text="Settings" wrapText="true" />
            <Button fx:id="logoutButton" onAction="#handleLogout" styleClass="nav-button" text="Logout" wrapText="true" />
        </HBox>
    </top>
    <center>
        <StackPane fx:id="contentRef" />
    </center>
</BorderPane>
