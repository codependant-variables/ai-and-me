<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.control.MenuButton?>
<?import javafx.scene.control.MenuItem?>

<BorderPane stylesheets="@stylesheet.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.codependentvariables.aiandme.controller.LayoutController">
    <top>
        <HBox alignment="CENTER" prefHeight="100.0" spacing="10.0" styleClass="navBar">
         <Region maxWidth="30.0" HBox.hgrow="ALWAYS" />
            <ImageView fx:id="logoRef" fitHeight="72.0" fitWidth="223.0" layoutY="10.0">
                <Image url="@dark-logo.png" />
            </ImageView>
         <Region HBox.hgrow="ALWAYS" />
            <!-- Navigation Buttons -->
            <Button fx:id="navigateAbout" onAction="#navigateAbout" styleClass="navButton">About</Button>
            <Button onAction="#navigateHome" styleClass="navButton">Home</Button>
            <Button onAction="#navigateQuizLibrary" styleClass="navButton">Quiz Library</Button>
           <!-- <Button onAction="#navigateCheckin" styleClass="navButton">Daily Check-in</Button> -->

            <Button fx:id="loginButton" onAction="#navigateLogin" styleClass="navButton">Login</Button>
            <Button fx:id="signupButton" onAction="#navigateSignup" styleClass="navButton">Signup</Button>
            <!-- Profile Dropdown -->
            <MenuButton fx:id="accountMenu"
                        text="Account"
                        styleClass="navButton">

                <items>
                    <MenuItem text="Profile"
                              onAction="#navigateProfile" />

                    <MenuItem text="Settings"
                              onAction="#navigateSettings" />

                    <MenuItem text="Logout"
                              onAction="#handleLogout" />
                </items>

            </MenuButton>

            <Region maxWidth="30.0" HBox.hgrow="ALWAYS" />
        </HBox>
    </top>
    <center>
        <StackPane fx:id="contentRef" />
    </center>
</BorderPane>
