<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.text.Font?>

<BorderPane stylesheets="@stylesheet.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.codependentvariables.aiandme.controller.LayoutController">
    <top>
        <HBox alignment="CENTER" prefHeight="100.0" spacing="10.0" styleClass="navBar">
         <Region maxWidth="30.0" HBox.hgrow="ALWAYS" />
            <ImageView fx:id="logoRef" fitHeight="72.0" fitWidth="223.0" layoutY="10.0">
                <Image url="@dark-logo.png" />
            </ImageView>
         <Region HBox.hgrow="ALWAYS" />
            <Button onAction="#navigateHome" prefHeight="48.0" prefWidth="86.0" styleClass="navButton" text="Home">
            <font>
               <Font size="10.0" />
            </font></Button>
            <Button onAction="#navigateQuizLibrary" prefHeight="48.0" prefWidth="137.0" styleClass="navButton" text="Quiz Library">
            <font>
               <Font size="10.0" />
            </font></Button>
         <Button layoutX="357.0" layoutY="36.0" onAction="#navigatePuzzleLibrary" prefHeight="48.0" prefWidth="154.0" styleClass="navButton" text="Puzzle Library">
            <font>
               <Font size="10.0" />
            </font>
         </Button>
            <Button onAction="#navigateCheckin" prefHeight="48.0" prefWidth="158.0" styleClass="navButton" text="Daily Check-in">
            <font>
               <Font size="10.0" />
            </font></Button>
            <Button fx:id="loginButton" onAction="#navigateLogin" styleClass="navButton" text="Login">
            <font>
               <Font size="10.0" />
            </font></Button>
            <Button fx:id="signupButton" onAction="#navigateSignup" styleClass="navButton" text="Signup">
            <font>
               <Font size="10.0" />
            </font></Button>
            <Button fx:id="profileButton" onAction="#navigateProfile" styleClass="navButton" text="Profile">
            <font>
               <Font size="10.0" />
            </font></Button>
            <Button onAction="#navigateSettings" styleClass="navButton" text="Settings">
            <font>
               <Font size="10.0" />
            </font></Button>
            <Button fx:id="logoutButton" onAction="#handleLogout" styleClass="navButton" text="Logout">
            <font>
               <Font size="10.0" />
            </font></Button>
         <Region maxWidth="30.0" HBox.hgrow="ALWAYS" />
        </HBox>
    </top>
    <center>
        <StackPane fx:id="contentRef" />
    </center>
</BorderPane>
