<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>

<BorderPane stylesheets="@stylesheet.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.codependentvariables.aiandme.controller.LayoutController">
    <top>
        <HBox alignment="CENTER" prefHeight="100.0" spacing="10.0">
            <ImageView fx:id="logoRef" fitHeight="72.0" fitWidth="223.0" layoutY="10.0" pickOnBounds="true" smooth="false">
            <image>
               <Image url="@dark-logo.png" />
            </image></ImageView>
            <Button onAction="#navigateHome" styleClass="navButton">Home</Button>
            <Button onAction="#navigateQuizLibrary" styleClass="navButton">Quiz Library</Button>
            <Button onAction="#navigateCheckin" styleClass="navButton">Daily Check-in</Button>
            <Button fx:id="loginButton" onAction="#navigateLogin" styleClass="navButton">Login</Button>
            <Button fx:id="signupButton" onAction="#navigateSignup" styleClass="navButton">Signup</Button>
            <Button fx:id="profileButton" onAction="#navigateProfile" styleClass="navButton">Profile</Button>
            <Button onAction="#navigateSettings" styleClass="navButton">Settings</Button>
            <Button fx:id="logoutButton" onAction="#handleLogout" styleClass="navButton">Logout</Button>
        </HBox>
    </top>
    <center>
        <StackPane fx:id="contentRef" />
    </center>
</BorderPane>
