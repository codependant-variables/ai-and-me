<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" stylesheets="@stylesheet.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1">
    <padding>
        <Insets topRightBottomLeft="20" />
    </padding>

    <Label fx:id="pageTitle" styleClass="title" text="Quiz Library" />

    <HBox spacing="10" alignment="CENTER_LEFT">
        <Label styleClass="bold" text="Category:" />
        <ComboBox fx:id="categoryFilter" onAction="#handleCategoryFilter" />

        <Region HBox.hgrow="ALWAYS" />

        <Label styleClass="bold" text="Options" />
        <Button fx:id="btnCreate" onAction="#handleCreate" styleClass="call-to-action" text="Create" />
        <Button fx:id="btnEdit" onAction="#handleEdit" styleClass="submission" text="Edit" />
        <Button fx:id="btnRename" onAction="#handleRename" styleClass="submission" text="Rename" />
        <Button fx:id="btnDelete" onAction="#handleDelete" styleClass="submission" text="Delete" />
    </HBox>

    <!-- ScrollPane allows overflow when many categories are added -->
    <ScrollPane fitToWidth="true" styleClass="innerDropshadow" VBox.vgrow="ALWAYS">
        <FlowPane fx:id="categoryContainer" hgap="15" style="-fx-padding: 10;" vgap="15">
            <!-- Category boxes are injected here dynamically via controller -->
        </FlowPane>
    </ScrollPane>

    <Button fx:id="btnStart" maxWidth="Infinity" onAction="#handleStart" prefHeight="39.0" style="-fx-padding: 10;" styleClass="call-to-action" text="Start Quiz" />
</VBox>
