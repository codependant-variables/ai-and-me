<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<VBox spacing="20.0" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.codependentvariables.aiandme.controller.LandingScreenController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
    </padding>
    <HBox VBox.vgrow="ALWAYS" spacing="20.0">
        <VBox spacing="10.0" prefWidth="400" fx:id="landingScreenContainer">
            <Label text="Welcome!" textAlignment="CENTER" />
            <HBox spacing="10.0" alignment="CENTER">
                <Button text="Sign Up" onAction="#handleGoToSignUp"/>
                <Button text="Login" onAction="#handleGoToLogin"/>
                <Button text="View as Guest" onAction="#handleGoToGuest"/>
            </HBox>
        </VBox>
    </HBox>
</VBox>