<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<VBox alignment="CENTER" maxWidth="300" spacing="10" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.codependentvariables.aiandme.controller.SetupMfaController">

    <ImageView fx:id="qrCodeImageView" fitHeight="150.0" fitWidth="200.0" pickOnBounds="true" preserveRatio="true" />
    <Button alignment="CENTER" onAction="#refreshQrCode" text="Refresh QR Code" />

    <Label alignment="CENTER" text="1. Scan the QR code in your authenticator app of choice, e.g. Google Authenticator." wrapText="true" />
    <Label alignment="CENTER" text="2. Enter a code generated by your authenticator app." wrapText="true" />
    <TextField fx:id="totpField" alignment="CENTER" onAction="#submit" />
    <Button alignment="CENTER" maxWidth="Infinity" onAction="#submit" styleClass="call-to-action" text="Submit" />

    <Button alignment="CENTER" maxWidth="Infinity" onAction="#navigateBack" text="Back">
        <VBox.margin>
            <Insets top="20.0" />
        </VBox.margin>
    </Button>

</VBox>
