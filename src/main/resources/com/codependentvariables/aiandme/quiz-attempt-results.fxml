<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.codependentvariables.aiandme.controller.QuizAttemptResultsController"
      spacing="16"
      style="-fx-padding: 20; -fx-background-color: #ffffff;"
      prefWidth="520">

    <!-- Score summary (SC 5) -->
    <VBox spacing="6" style="-fx-background-color: #f5f5f5; -fx-padding: 14; -fx-background-radius: 8;">
        <Label fx:id="lblQuizName"
               style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #212121;"
               wrapText="true"/>
        <HBox spacing="12" alignment="CENTER_LEFT">
            <Label fx:id="lblScore"
                   style="-fx-font-size: 15px; -fx-text-fill: #424242;"/>
            <Label fx:id="lblPercentage"
                   style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #1976d2;"/>
        </HBox>
        <Label fx:id="lblCompletedAt"
               style="-fx-font-size: 12px; -fx-text-fill: #9e9e9e;"/>
    </VBox>

    <!-- Per-question breakdown header (SC 6) -->
    <Label text="Question breakdown"
           style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #757575;"/>

    <!-- Rows injected by controller -->
    <ScrollPane fitToWidth="true" prefHeight="280" style="-fx-background-color: transparent;">
        <VBox fx:id="resultsContainer" spacing="8" style="-fx-padding: 2;"/>
    </ScrollPane>

</VBox>