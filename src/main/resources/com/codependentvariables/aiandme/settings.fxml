<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.shape.SVGPath?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.ColumnConstraints?>

<GridPane fx:id="background" alignment="CENTER" prefHeight="200.0" prefWidth="200.0" vgap="10" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.codependentvariables.aiandme.controller.SettingsController">

   <columnConstraints>
      <ColumnConstraints maxWidth="250" />
   </columnConstraints>

   <Button maxWidth="Infinity" onAction="#switchTheme" GridPane.rowIndex="0" GridPane.halignment="CENTER">
      <graphic>
         <SVGPath fx:id="themeIcon" nodeOrientation="LEFT_TO_RIGHT"/>
      </graphic>
   </Button>
   <Button maxWidth="Infinity" text="Change Orientation" onAction="#switchOrientation" GridPane.rowIndex="1" />
   <Button maxWidth="Infinity" text="Revert to Default Settings" onAction="#revertToDefaultSettings" GridPane.rowIndex="2" />

</GridPane>
