<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>

<?import javafx.geometry.Insets?>
<StackPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml" fx:controller="com.codependentvariables.aiandme.controller.DialogueController">
    <Region style="-fx-background-color: rgba(0, 0, 0, 0.5);" onMouseClicked="#onBackgroundClick" />
    <VBox alignment="CENTER" styleClass="card" spacing="20" maxWidth="-Infinity" maxHeight="-Infinity">
        <padding>
            <Insets topRightBottomLeft="20" />
        </padding>
        <Label fx:id="messageRef" text="Placeholder" wrapText="true" maxWidth="400" />
        <HBox alignment="CENTER" spacing="20">
            <Button fx:id="yesRef" onAction="#onClick" text="Yes" />
            <Button fx:id="noRef" onAction="#onClick" text="No" />
            <Button fx:id="cancelRef" onAction="#onClick" text="Cancel" />
        </HBox>
    </VBox>
</StackPane>