<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.Slider?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.SVGPath?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<AnchorPane maxHeight="768.0" styleClass="background-AnchorPane" stylesheets="@stylesheet.css"
            AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0"
            AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.codependentvariables.aiandme.controller.CheckInController">

   <StackPane maxHeight="768.0" prefHeight="150.0" prefWidth="200.0" styleClass="background-StackPane">
      <children>
         <VBox maxHeight="768.0" maxWidth="550.0" prefWidth="550.0" styleClass="Quiz-Backing-VBox">

            <HBox alignment="BOTTOM_CENTER" prefHeight="100.0" prefWidth="200.0">
               <VBox alignment="CENTER" prefHeight="200.0" prefWidth="100.0">
                  <Text strokeType="OUTSIDE" strokeWidth="0.0" text="Daily Check-in" textAlignment="CENTER">
                     <font>
                        <Font size="24.0" />
                     </font>
                  </Text>
                  <Separator prefWidth="200.0" />
               </VBox>
            </HBox>

            <HBox alignment="CENTER" prefHeight="100.0" prefWidth="200.0">
               <VBox alignment="CENTER" prefHeight="200.0" prefWidth="400.0">
                  <Text strokeType="OUTSIDE" strokeWidth="0.0"
                        text="How satisfied are you with your AI use since last check-in?" />

                  <HBox prefHeight="10.0" prefWidth="200.0">
                     <Text strokeType="OUTSIDE" strokeWidth="0.0" styleClass="supportingText" text="Unsatisfied" />
                     <Pane maxHeight="10.0" HBox.hgrow="ALWAYS" />
                     <Text strokeType="OUTSIDE" strokeWidth="0.0" styleClass="supportingText" text="Satisfied" />
                  </HBox>

                  <Slider fx:id="satisfactionSlider"
                          min="0.0"
                          max="10.0"
                          value="5.0"
                          minWidth="400.0"
                          prefWidth="400.0" />
               </VBox>
            </HBox>

            <HBox alignment="CENTER" prefHeight="100.0" prefWidth="574.0">
               <VBox alignment="CENTER" prefHeight="200.0" prefWidth="400.0">
                  <Text strokeType="OUTSIDE" strokeWidth="0.0"
                        text="How dependent on AI do you feel you've become since your last check in?"
                        textAlignment="CENTER" />

                  <HBox prefHeight="10.0" prefWidth="200.0">
                     <Text strokeType="OUTSIDE" strokeWidth="0.0" styleClass="supportingText" text="Dependant" />
                     <Pane maxHeight="10.0" HBox.hgrow="ALWAYS" />
                     <Text strokeType="OUTSIDE" strokeWidth="0.0" styleClass="supportingText" text="Independant" />
                  </HBox>

                  <Slider fx:id="dependenceSlider"
                          min="0.0"
                          max="10.0"
                          value="5.0"
                          prefWidth="400.0" />
               </VBox>
            </HBox>

            <HBox alignment="CENTER" prefHeight="100.0" prefWidth="200.0">
               <VBox alignment="CENTER" prefHeight="200.0" prefWidth="400.0">
                  <Text strokeType="OUTSIDE" strokeWidth="0.0"
                        text="How much have you been using AI since last check in?" />

                  <HBox prefHeight="10.0" prefWidth="200.0">
                     <Text strokeType="OUTSIDE" strokeWidth="0.0" styleClass="supportingText" text="No use" />
                     <Pane maxHeight="10.0" HBox.hgrow="ALWAYS" />
                     <Text strokeType="OUTSIDE" strokeWidth="0.0" styleClass="supportingText" text="High use" />
                  </HBox>

                  <Slider fx:id="usageSlider"
                          min="0.0"
                          max="10.0"
                          value="5.0"
                          minWidth="400.0"
                          prefWidth="400.0" />
               </VBox>
            </HBox>

            <HBox alignment="CENTER" prefHeight="204.0" prefWidth="614.0">
               <VBox alignment="CENTER" prefHeight="275.0" prefWidth="217.0">
                  <Text strokeType="OUTSIDE" strokeWidth="0.0" text="Add any additional thoughts below:" />

                  <TextArea fx:id="thoughtsTextArea"
                            minHeight="-Infinity"
                            minWidth="-Infinity"
                            prefHeight="100.0"
                            prefWidth="400.0" />

                  <HBox alignment="CENTER" spacing="10" prefHeight="100.0" prefWidth="200.0">
                     <Button mnemonicParsing="false"
                             onAction="#submitCheckIn"
                             styleClass="submissionButton"
                             text="Submit Check-in" />

                     <Button mnemonicParsing="false"
                             onAction="#navigateHome"
                             style="-fx-background-color: #8CC978;"
                             styleClass="submissionButton">
                        <graphic>
                           <SVGPath content="M14.611 6.622 8.927 2.221a0.438 0.438 0 0 0 -0.541 0.005L2.879 6.627a0.467 0.467 0 0 0 -0.163 0.341v7.961a0.438 0.438 0 0 0 0.439 0.439h3.271a0.438 0.438 0 0 0 0.439 -0.439V10.057h3.771v4.876a0.438 0.438 0 0 0 0.439 0.439h3.271a0.438 0.438 0 0 0 0.439 -0.439V6.972a0.467 0.467 0 0 0 -0.168 -0.345"
                                    fill="WHITE" />
                        </graphic>
                     </Button>
                  </HBox>
               </VBox>
            </HBox>

         </VBox>
      </children>
   </StackPane>
</AnchorPane>