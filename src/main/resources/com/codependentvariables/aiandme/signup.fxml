<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>

<AnchorPane maxHeight="-Infinity" maxWidth="-Infinity" styleClass="background-AnchorPane" stylesheets="@stylesheet.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.codependentvariables.aiandme.controller.SignupController">

   <ImageView fitHeight="768.0" fitWidth="1024.0" opacity="0.5" pickOnBounds="true" preserveRatio="true" AnchorPane.bottomAnchor="0.0">
      <Image url="@Images/PuzzleWidgetIcon.png" />
   </ImageView>

   <GridPane alignment="CENTER" styleClass="login-menu" AnchorPane.bottomAnchor="50.0" AnchorPane.leftAnchor="50.0" AnchorPane.rightAnchor="50.0" AnchorPane.topAnchor="50.0">

      <columnConstraints>
         <ColumnConstraints prefWidth="80.0" />
         <ColumnConstraints prefWidth="300.0" />
         <ColumnConstraints prefWidth="30.0" />
      </columnConstraints>

      <ImageView fx:id="logoRef" fitWidth="255.0" pickOnBounds="true" preserveRatio="true" GridPane.columnIndex="1"  GridPane.halignment="CENTER" GridPane.rowIndex="0">
         <Image url="@dark-logo.png" />
      </ImageView>

      <Label styleClass="title" text="Signup" GridPane.columnIndex="1" GridPane.rowIndex="1">
         <padding>
            <Insets bottom="10" top="30" />
         </padding>
      </Label>

      <Label text="Name:" GridPane.columnIndex="0" GridPane.halignment="RIGHT" GridPane.rowIndex="2" />
      <TextField fx:id="nameField" maxWidth="Infinity" onAction="#onSignup" GridPane.columnIndex="1" GridPane.rowIndex="2" />

      <Label text="Email:" GridPane.columnIndex="0" GridPane.halignment="RIGHT" GridPane.rowIndex="3" />
      <TextField fx:id="emailField" maxWidth="Infinity" onAction="#onSignup" GridPane.columnIndex="1" GridPane.rowIndex="3" />

      <Label text="Password:" GridPane.columnIndex="0" GridPane.halignment="RIGHT" GridPane.rowIndex="4" />
      <StackPane GridPane.columnIndex="1" GridPane.rowIndex="4">
         <PasswordField fx:id="passwordField" maxWidth="Infinity" />
         <TextField fx:id="passwordTextField" maxWidth="Infinity" visible="false" />
      </StackPane>
      <Button minWidth="-Infinity" onAction="#showPassword" style="-fx-background-color: transparent;" GridPane.columnIndex="2" GridPane.halignment="CENTER" GridPane.rowIndex="4" GridPane.valignment="CENTER">
         <graphic>
            <SVGPath fx:id="viewPasswordIcon" content="M21.821 12.43c-.083-.119-2.062-2.944-4.793-4.875-1.416-1.003-3.202-1.555-5.028-1.555-1.825 0-3.611.552-5.03 1.555-2.731 1.931-4.708 4.756-4.791 4.875-.238.343-.238.798 0 1.141.083.119 2.06 2.944 4.791 4.875 1.419 1.002 3.205 1.554 5.03 1.554 1.826 0 3.612-.552 5.028-1.555 2.731-1.931 4.71-4.756 4.793-4.875.239-.342.239-.798 0-1.14zm-9.821 4.07c-1.934 0-3.5-1.57-3.5-3.5 0-1.934 1.566-3.5 3.5-3.5 1.93 0 3.5 1.566 3.5 3.5 0 1.93-1.57 3.5-3.5 3.5zM14 13c0 1.102-.898 2-2 2-1.105 0-2-.898-2-2 0-1.105.895-2 2-2 1.102 0 2 .895 2 2z" />
         </graphic>
      </Button>

      <Button maxWidth="Infinity" onAction="#onSignup" style="-fx-background-color: #8cc978; -fx-text-fill: #ffffff;" styleClass="bold" text="Sign Up" GridPane.columnIndex="1" GridPane.rowIndex="5" />

      <HBox alignment="CENTER" spacing="10.0" GridPane.columnIndex="1" GridPane.rowIndex="6">
         <padding>
            <Insets top="20" />
         </padding>
         <Button onAction="#navigateLogin" styleClass="submissionButton" text="Have an Account?" />
         <Button onAction="#navigateHome" styleClass="submissionButton" text="Use as a Guest" />
      </HBox>

   </GridPane>
</AnchorPane>
