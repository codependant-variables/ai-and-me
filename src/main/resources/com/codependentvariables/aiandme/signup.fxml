<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>

<StackPane styleClass="shadow" stylesheets="@stylesheet.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.codependentvariables.aiandme.controller.SignupController">

    <ImageView StackPane.alignment="BOTTOM_CENTER" opacity="0.5" pickOnBounds="true" preserveRatio="true">
        <Image url="@Images/BackgroundHighRes.png" />
    </ImageView>

    <GridPane StackPane.alignment="CENTER" alignment="CENTER" styleClass="login-menu">

        <columnConstraints>
            <ColumnConstraints prefWidth="80.0" />
            <ColumnConstraints prefWidth="300.0" />
            <ColumnConstraints prefWidth="30.0" />
        </columnConstraints>

        <ImageView fx:id="logoRef" fitWidth="255.0" pickOnBounds="true" preserveRatio="true" GridPane.columnIndex="1" GridPane.halignment="CENTER" GridPane.rowIndex="0">
            <Image url="@dark-logo.png" />
        </ImageView>

        <Label styleClass="title" text="Signup" GridPane.columnIndex="1" GridPane.rowIndex="1">
            <padding>
                <Insets bottom="10" top="30" />
            </padding>
        </Label>

        <Label text="Name:" GridPane.columnIndex="0" GridPane.halignment="RIGHT" GridPane.rowIndex="2" />
        <TextField fx:id="nameField" maxWidth="Infinity" onAction="#onSignup" GridPane.columnIndex="1" GridPane.rowIndex="2" />

        <Label text="Email:" GridPane.columnIndex="0" GridPane.halignment="RIGHT" GridPane.rowIndex="3" />
        <TextField fx:id="emailField" maxWidth="Infinity" onAction="#onSignup" GridPane.columnIndex="1" GridPane.rowIndex="3" />

        <Label text="Password:" GridPane.columnIndex="0" GridPane.halignment="RIGHT" GridPane.rowIndex="4" />
        <StackPane GridPane.columnIndex="1" GridPane.rowIndex="4">
            <PasswordField fx:id="passwordField" onAction="#onSignup" maxWidth="Infinity" />
            <TextField fx:id="passwordTextField" onAction="#onSignup" maxWidth="Infinity" visible="false" />
        </StackPane>
        <Button minWidth="-Infinity" onAction="#toggleViewPassword" style="-fx-background-color: transparent;" GridPane.columnIndex="2" GridPane.halignment="CENTER" GridPane.rowIndex="4" GridPane.valignment="CENTER">
            <graphic>
                <SVGPath fx:id="viewPasswordIcon" />
            </graphic>
        </Button>

        <Button maxWidth="Infinity" onAction="#onSignup" styleClass="call-to-action" text="Sign Up" GridPane.columnIndex="1" GridPane.rowIndex="5" />

        <HBox alignment="CENTER" spacing="10.0" GridPane.columnIndex="1" GridPane.rowIndex="6">
            <padding>
                <Insets top="20" />
            </padding>
            <Button onAction="#navigateLogin" styleClass="submission" text="Have an Account?" />
            <Button onAction="#navigateHome" styleClass="submission" text="Use as a Guest" />
        </HBox>

    </GridPane>

</StackPane>
