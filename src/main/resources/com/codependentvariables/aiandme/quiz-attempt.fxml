<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<?import javafx.geometry.Insets?>
<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.codependentvariables.aiandme.controller.QuizAttemptController"
      spacing="14"
      prefWidth="500"
      styleClass="page">

<padding>
    <Insets top="16" right="16" bottom="16" left="16"/>
</padding>

<Label fx:id="progressLabel"
       textFill="#777777"/>

<Label fx:id="questionLabel"
       wrapText="true"
       style="-fx-font-size: 16px; -fx-font-weight: bold;"/>

<VBox fx:id="answersBox"
      spacing="10"/>

<HBox alignment="CENTER_RIGHT" spacing="10">
    <Button text="Cancel" onAction="#navigateBack"/>
    <Button fx:id="nextButton" text="Next &gt;" onAction="#handleNext"/>
</HBox>

</VBox>

