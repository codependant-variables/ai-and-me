<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.geometry.Insets?>

<VBox alignment="CENTER" maxWidth="600" styleClass="page" spacing="20" xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml" fx:controller="com.codependentvariables.aiandme.controller.QuizAttemptController">
    <padding>
        <Insets top="16" right="16" bottom="16" left="16" />
    </padding>

    <Label fx:id="progressLabel" textFill="#777777" />

    <ImageView fx:id="questionImageView" fitWidth="410" fitHeight="330" preserveRatio="true" visible="false" managed="false" />

    <Label fx:id="questionLabel" wrapText="true" style="-fx-font-size: 16px; -fx-font-weight: bold;" />

    <VBox fx:id="answersBox" spacing="10" />

    <HBox alignment="CENTER_RIGHT" spacing="10">
        <Button text="Cancel" onAction="#navigateBack" />
        <Button fx:id="nextButton" text="Next &gt;" onAction="#handleNext" />
    </HBox>
</VBox>

